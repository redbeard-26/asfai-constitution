// ASFAI Constitution Wiki — Prisma schema (PostgreSQL / Neon / Vercel Postgres)
//
// Enum-like fields (role, category, status) are stored as String and validated
// in application code (TypeScript unions + Zod). This keeps seeding simple and
// lets us add new values without a migration. See src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs live in prisma.config.ts (CLI/migrations) and are
  // provided to PrismaClient via a driver adapter at runtime (see src/lib/prisma.ts).
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("VIEWER") // VIEWER | MODERATOR | ADMIN
  archivedAt    DateTime? // soft archive — hides the user's votes/comments/pending proposals
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  revisions Revision[]
  proposals EditProposal[] @relation("ProposalAuthor")
  reviewed  EditProposal[] @relation("ProposalReviewer")
  comments  Comment[]
  auditLogs AuditLog[]
  documents Document[]
  votes     Vote[]
  masteries ConceptMastery[]
  trackerSubmissions TrackerSubmission[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Wiki content models
// ---------------------------------------------------------------------------

model Page {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  type              String // CONSTITUTION | ARTICLE | THESIS | CANDIDATE
  parentId          String?
  sortOrder         Int      @default(0)
  caseFor           String? // summary: why this thesis should be included
  caseAgainst       String? // summary: why it should be excluded or changed
  currentRevisionId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parent          Page?          @relation("PageTree", fields: [parentId], references: [id])
  children        Page[]         @relation("PageTree")
  currentRevision Revision?      @relation("CurrentRevision", fields: [currentRevisionId], references: [id])
  revisions       Revision[]     @relation("PageRevisions")
  proposals       EditProposal[]
  comments        Comment[]
  documentLinks   DocumentLink[]
  votes           Vote[]

  @@index([parentId])
}

model Vote {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  value     Int // +1 (up) or -1 (down)
  createdAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([pageId])
}

model Document {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  kind        String    @default("Reference") // Panel Report, External Resource, Reference, Memo
  source      String? // organization or author, e.g. "Collective Intelligence Project"
  eventDate   DateTime?
  summary     String?
  body        String? // markdown; optional for external resources
  fileUrl     String? // external / original URL
  // Moderation gate: -1 = newly added, pending moderator review (hidden from
  // the public library, search, and page panels); >= 0 = reviewed/published.
  relevance   Float     @default(-1)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User?          @relation(fields: [createdById], references: [id])
  links     DocumentLink[]
}

model DocumentLink {
  id         String   @id @default(cuid())
  documentId String
  pageId     String
  relevance  Float    @default(0.5) // 0-1, hidden; orders related resources (desc)
  stance     String   @default("NEUTRAL") // SUPPORTS | OPPOSES | NEUTRAL
  note       String?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page     Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageId])
  @@index([pageId])
}

model Revision {
  id        String   @id @default(cuid())
  pageId    String
  content   String
  summary   String?
  authorId  String?
  createdAt DateTime @default(now())

  page             Page           @relation("PageRevisions", fields: [pageId], references: [id], onDelete: Cascade)
  author           User?          @relation(fields: [authorId], references: [id])
  currentOf        Page?          @relation("CurrentRevision")
  baseForProposals EditProposal[] @relation("ProposalBase")
}

model EditProposal {
  id              String    @id @default(cuid())
  pageId          String
  baseRevisionId  String?
  proposedContent String
  summary         String?
  authorId        String
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewerId      String?
  reviewNote      String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  page         Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  baseRevision Revision? @relation("ProposalBase", fields: [baseRevisionId], references: [id])
  author       User      @relation("ProposalAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewer     User?     @relation("ProposalReviewer", fields: [reviewerId], references: [id])

  @@index([status])
  @@index([pageId])
}

model Comment {
  id        String   @id @default(cuid())
  pageId    String
  authorId  String
  parentId  String?
  body      String
  status    String   @default("VISIBLE") // VISIBLE | HIDDEN
  createdAt DateTime @default(now())

  page    Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentThread")

  @@index([pageId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  meta       String? // JSON string
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])
}

// AI Personhood Tracker — scored questions across two axes (SOCIAL integration
// and CONSCIOUSNESS likelihood). Each axis score is the quadratic mean of its
// questions' ratings; the pair plots against the "personhood horizon".
model TrackerQuestion {
  id          String   @id @default(cuid())
  key         String   @unique
  category    String // SOCIAL | CONSCIOUSNESS
  sortOrder   Int      @default(0)
  question    String
  rating      Int      @default(0) // 0-100
  explanation String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// ---------------------------------------------------------------------------
// Knowledge-graph learning tutor
// ---------------------------------------------------------------------------

// A learner's mastery of one micro-topic from the bundled Marble Open Skill
// Taxonomy (src/content/taxonomy). The taxonomy itself is static reference data
// loaded in-memory (src/lib/taxonomy.ts); only this per-user progress is stored.
// topicId is the taxonomy's stable string id (e.g. "mt_N8CpN1EJrP"), kept loose
// so progress survives taxonomy updates.
model ConceptMastery {
  id         String    @id @default(cuid())
  userId     String
  topicId    String // taxonomy topic id, e.g. "mt_N8CpN1EJrP"
  status     String    @default("LEARNING") // LEARNING | MASTERED
  evidence   String? // tutor's note on how mastery was demonstrated
  assessedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
}
// A person's personal assessment of AI personhood: one saved set of per-question
// ratings, named and owned by the submitting user. Submissions are public and a
// user may keep several to track how their view shifts over time.
model TrackerSubmission {
  id        String   @id @default(cuid())
  userId    String
  name      String // user-editable label, e.g. "My take, July 2026"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses TrackerResponse[]

  @@index([userId])
}

// One slider value within a submission. questionKey is a loose reference to
// TrackerQuestion.key (kept as a string so a submission survives question edits).
model TrackerResponse {
  id           String @id @default(cuid())
  submissionId String
  questionKey  String
  rating       Int // 1-100

  submission TrackerSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionKey])
  @@index([submissionId])
}

// ---------------------------------------------------------------------------
// Autonomy Zone game
// ---------------------------------------------------------------------------

// A submitted score from the "Autonomy Zone" battlefield prototype. Anonymous
// and global — anyone who finishes a game may optionally add their result to a
// shared leaderboard. No user relation: the name is free text the player types.
model HighScore {
  id        String   @id @default(cuid())
  name      String
  score     Int
  outcome   String // WON | LOST
  ticks     Int
  civilians Int
  createdAt DateTime @default(now())

  @@index([score])
}
