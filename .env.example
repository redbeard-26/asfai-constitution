# ---------------------------------------------------------------------------
# Database (Vercel Postgres / Neon)
# ---------------------------------------------------------------------------
# Pooled connection — used by the app at runtime (serverless-friendly).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (non-pooled) connection — used by Prisma migrate / db push.
# On Vercel Postgres this is POSTGRES_URL_NON_POOLING / DATABASE_URL_UNPOOLED.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# ---------------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public URL of the app. http://localhost:3000 in dev; your domain in prod.
AUTH_URL="http://localhost:3000"

# Google OAuth (optional in dev). Create at https://console.cloud.google.com
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email magic-link delivery via Resend (https://resend.com). Optional in dev:
# if AUTH_RESEND_KEY is empty, magic links are printed to the server console.
AUTH_RESEND_KEY=""
EMAIL_FROM="ASFAI Constitution <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# App bootstrap
# ---------------------------------------------------------------------------
# Comma-separated emails that are auto-promoted to ADMIN on sign-in / seed.
ADMIN_EMAILS=""
